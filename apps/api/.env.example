NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# In Supabase Dashboard > Connect, choose Session pooler for a long-running Node.js API.
# URL-encode special characters in your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
