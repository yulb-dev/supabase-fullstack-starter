{
  "name": "supabase-fullstack-starter",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @starter/api --filter @starter/web dev",
    "build": "pnpm --filter @starter/api build && pnpm --filter @starter/web build",
    "typecheck": "pnpm --filter @starter/api typecheck && pnpm --filter @starter/web typecheck",
    "test": "pnpm --filter @starter/api test",
    "db:push": "supabase db push",
    "db:status": "supabase migration list"
  },
  "devDependencies": {
    "supabase": "2.120.0"
  }
}
