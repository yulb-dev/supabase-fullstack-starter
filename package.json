{
  "name": "supabase-fullstack-starter",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @starter/api --filter @starter/web dev",
    "build": "pnpm --filter @starter/api build && pnpm --filter @starter/web build",
    "typecheck": "pnpm --filter @starter/api typecheck && pnpm --filter @starter/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @starter/api test && pnpm --filter @starter/web test",
    "test:coverage": "pnpm --filter @starter/web test:coverage",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:push": "supabase db push",
    "db:status": "supabase migration list"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.0"
  }
}
